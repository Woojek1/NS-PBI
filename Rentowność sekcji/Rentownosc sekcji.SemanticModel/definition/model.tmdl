model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pl-PL
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["margin_data","pricelist_price"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table margin_data
ref table pricelist_price
ref table _Measures
ref table Discount
ref table D&I

ref cultureInfo en-US

