        },
        {
          "name": "AVG",
          "dataType": "Double",
          "expression": "\r\nCALCULATE(\r\n    [Margin I (%) CUR DOM],\r\n    REMOVEFILTERS(),\r\n    'Date'[yearc_name] = \"2026\"\r\n)",
          "formatString": "General Number",
          "displayFolder": "Report LRD",
          "references": {
