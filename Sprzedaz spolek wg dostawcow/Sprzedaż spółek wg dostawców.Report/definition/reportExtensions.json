          }
        },
        {
          "name": "Margin I (%) CUR DOM",
          "dataType": "Double",
          "expression": "\r\nROUND(\r\n    [Margin I CUR DOM] / [Net Sales CUR Dom],\r\n    2\r\n)",
          "formatString": "0.00\\ %;-0.00\\ %;0.00\\ %",
          "displayFolder": "Report LRD",
          "references": {
