expression 'DirectQuery to AS - Sales Tabular Model' =
		let
		    Source = AnalysisServices.Database("asazure://northeurope.asazure.windows.net/asnsgsolet", "Sales Tabular Model"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Sales Model", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: 5e9dcad0-0992-4c5d-b37c-f8b0fc1b9caa

	annotation PBI_IncludeFutureArtifacts = True

