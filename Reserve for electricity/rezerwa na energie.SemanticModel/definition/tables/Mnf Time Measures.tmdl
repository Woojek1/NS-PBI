table 'Mnf Time Measures'
	lineageTag: 98f0f041-6430-4c94-bb19-78307b431385

	measure 'Machine Time' = EXTERNALMEASURE("Machine Time", DOUBLE, "Połączenie DirectQuery z elementem AS — Manufacturing Costs Tabular Model")
		lineageTag: c4694c15-298d-4b4b-83f0-1e4d2eb67540
		sourceLineageTag: Połączenie DirectQuery z elementem AS — Manufacturing Costs Tabular Model.Machine Time
		dataCategory: Uncategorized

	measure 'Labor Crew Time' = EXTERNALMEASURE("Labor Crew Time", DOUBLE, "Połączenie DirectQuery z elementem AS — Manufacturing Costs Tabular Model")
		lineageTag: 7cc7e39c-4498-4e53-9d5c-ddbed1ce1815
		sourceLineageTag: Połączenie DirectQuery z elementem AS — Manufacturing Costs Tabular Model.Labor Crew Time
		dataCategory: Uncategorized

	measure '% of Labor&Machine (Contract)' = ```
			DIVIDE(
			                            [Labor Crew Time plus Machine Time], 
			                            CALCULATE(
			                                        [Labor Crew Time plus Machine Time] ,
			                                        ALLSELECTED(Organization[MPK Code])
			                                    )
			                        )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4bcd9648-bf17-4ff9-8f06-39c9d887c0f4

	measure 'Labor&Machine Time' = sum('Mnf Time Measures'[labor_crew_time])
		lineageTag: 48df0463-0259-4f43-952c-5ae136c31274

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% of Labor (Contract)' = ```
			DIVIDE(
			                            [Labor Crew Time], 
			                            CALCULATE(
			                                         [Labor Crew Time] ,
			                                        ALLSELECTED(Organization[MPK Code])
			                                    )
			                        )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 41670992-dcd3-41b3-bf13-19df197ea8da

