		table 'Arkusz 1'
			lineageTag: 6ed21d07-85e6-400e-a419-c262a3f851eb

			measure Rezerwa =
					
					CALCULATE(
					    SUM('Mnf Time Measures'[manufacturing_time]),
					    TREATAS(
					        VALUES('Month Mnf Cost'[Month Code]),
					        'Mnf Bud Time Measures'[bud_manufacturing_time]
					    )
					)
				lineageTag: 9504a903-b603-4b43-88a2-ecdc3aa197e5

				annotation PBI_FormatHint = {"isGeneralNumber":true}

