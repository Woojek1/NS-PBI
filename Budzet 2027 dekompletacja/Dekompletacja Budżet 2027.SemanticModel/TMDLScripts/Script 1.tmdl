			measure Time = sum(bdg_27_godziny_added_mpk[total_time])
				formatString: #,0
				lineageTag: 22a37f5b-32c0-4fba-bbfb-a91a90ad8b93

			measure 'Labour H' = SUM(bdg_27_godziny_added_mpk[total_labour_time])
