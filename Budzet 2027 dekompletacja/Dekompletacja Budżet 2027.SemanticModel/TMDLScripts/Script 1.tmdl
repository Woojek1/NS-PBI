createOrReplace

	model Model
		culture: en-US
		defaultPowerBIDataSourceVersion: powerBI_V3
		sourceQueryCulture: pl-PL
		dataAccessOptions
			legacyRedirects
			returnErrorValuesAsNull

		table 'Mnf Time Measures'
			lineageTag: 80c1f218-2be4-442e-b6d0-ef9c4c3f1819

			measure 'Machine Time' = EXTERNALMEASURE("Machine Time", DOUBLE, "DirectQuery to AS - Manufacturing Costs Tabular Model")
				lineageTag: 3a4251ae-657a-44b3-93d6-5b0c3ff75cef
				sourceLineageTag: DirectQuery to AS - Manufacturing Costs Tabular Model.Machine Time
				dataCategory: Uncategorized

			measure 'Labor Crew Time' = EXTERNALMEASURE("Labor Crew Time", DOUBLE, "DirectQuery to AS - Manufacturing Costs Tabular Model")
				lineageTag: 4f244ff1-9399-4e07-b836-23fd98867bfd
				sourceLineageTag: DirectQuery to AS - Manufacturing Costs Tabular Model.Labor Crew Time
				dataCategory: Uncategorized

			measure 'Actual Time Selected' =
					
					VAR SelectedType =
					    SELECTEDVALUE(
					        'Measure Selector'[Time Type],
					        "Pracochłonność"
					    )
					RETURN
					    SWITCH(
					        SelectedType,
					        "Pracochłonność", [Labor Crew Time],
					        "Maszynochłonność", [Machine Time]
					    )
				formatString: #,0
				lineageTag: 83fee02e-bc70-4889-92b5-0f2224d00acd

				changedProperty = Name

				changedProperty = FormatString

				annotation PBI_FormatHint = {"isDecimal":true}

