				annotation PBI_FormatHint = {"isDecimal":true}

			measure 'Budget Time Selected' =
					
					VAR SelectedType =
					    SELECTEDVALUE(
					        'Measure Selector'[Time Type],
					        "Pracochłonność"
					    )
					RETURN
					    SWITCH(
					        SelectedType,
					        "Pracochłonność", [Labour H],
					        "Maszynochłonność", [Time]
					    )
				formatString: #,0
