	measure 'Bud Time Selected' =
			
			VAR SelectedType =
			    SELECTEDVALUE(
			        'Measure Selector'[Time Type],
			        "Pracochłonność"
			    )
			RETURN
			    SWITCH(
			        SelectedType,
			        "Pracochłonność", [Bud Labor Crew Time],
			        "Maszynochłonność", [Bud Manufacturing Time]
			    )
		formatString: #,0
