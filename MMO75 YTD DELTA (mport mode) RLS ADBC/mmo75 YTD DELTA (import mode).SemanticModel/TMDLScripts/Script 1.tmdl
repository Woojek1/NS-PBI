				annotation PBI_FormatHint = {"isDecimal":true}

			measure '!Discount (PLN)' =
					
					[Base Sales PLN] - [Net Sales PLN]
				lineageTag: 9acfb5c6-ae46-4568-b7ad-5cf5c5b0be53

				annotation PBI_FormatHint = {"isGeneralNumber":true}

