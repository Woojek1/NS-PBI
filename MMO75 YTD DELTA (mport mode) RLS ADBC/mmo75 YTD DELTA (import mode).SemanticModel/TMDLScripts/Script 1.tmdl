				lineageTag: 66ebfd4b-ef74-4b5b-a54b-ef349cd7efa5

			measure 'Margin II % (EUR)' = IF([Net Sales EUR] = BLANK(), BLANK(), [Margin II EUR] / [Net Sales EUR])
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: 0b358023-d2ab-46de-a1e0-702b1c9842d5

			measure 'Margin I (prim) PLN' = [Margin I PLN] - [Complaint Product PLN] - [Variance Fixed Cost PLN]
