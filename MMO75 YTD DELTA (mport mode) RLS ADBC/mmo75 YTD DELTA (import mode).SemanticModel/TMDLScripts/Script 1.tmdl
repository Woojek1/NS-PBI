				lineageTag: 68ffe78a-ba9b-4353-9fad-85e52cf1347a

			measure 'Margin I (prim) % (EUR)' = IF([Net Sales EUR] = BLANK(), BLANK(), [Margin I (prim) EUR] / [Net Sales EUR])
